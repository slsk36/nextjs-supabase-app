# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인합니다.

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (대시보드에는 anon/public key 로 표시될 수 있습니다).
# 주의: 이 프로젝트는 변수명이 ANON_KEY 가 아니라 PUBLISHABLE_KEY 입니다.
# 이름이 틀리면 에러 없이 인증이 조용히 비활성화됩니다 (lib/utils.ts 의 hasEnvVars).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
